# ===========================================================
# FundScope - Variables de entorno
# Copia este archivo como .env y completa tus valores.
# El archivo .env NO debe subirse al repositorio.
# ===========================================================

# --- Alpha Vantage (OPCIONAL: titulares con sentimiento) --
# Solo si NOTICIAS_FUENTE=alphavantage. Clave: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=tu_clave_aqui
ALPHA_VANTAGE_URL=https://www.alphavantage.co/query

# --- Ollama (Qwen3 local, proveedor principal) ------------
OLLAMA_HOST=http://localhost
OLLAMA_PUERTO=11434
OLLAMA_MODELO=qwen3:8b
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURA=0.3

# --- Gemini (respaldo opcional si Ollama no esta listo) ---
# Si se configura, los datos del analisis se envian a la API de Google.
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT=60
GEMINI_TEMPERATURA=0.3
# Solo para pruebas: "qwen3" o "gemini" fija el proveedor. Vacio = automatico.
PROVEEDOR_LLM_FORZADO=
# Segundos que se reutiliza la verificacion del proveedor
PROVEEDOR_LLM_TTL=120

# --- Parametros del analisis ------------------------------
# Vacio = el fondo inicial es el mejor del ranking del perfil elegido. Si pones
# un ticker del catalogo (p. ej. BND), se usa cuando pertenece al perfil; otros
# tickers (p. ej. VFIAX) se analizan con la opcion «Otro ticker» de la app.
FONDO_POR_DEFECTO=
# Benchmark SOLO para fondos fuera del catalogo de bonos (los del catalogo usan
# BIL en Conservador y AGG en Moderado/Agresivo). ^SP500TR incluye dividendos.
BENCHMARK_POR_DEFECTO=^SP500TR
# Vacio = se detecta el ETF equivalente para buscar noticias (VFIAX -> VOO)
TICKER_NOTICIAS=
PERIODO_HISTORICO=5y
# Respaldo: la app lee la tasa vigente de las letras del Tesoro (^IRX)
TASA_LIBRE_RIESGO=0.045
DIAS_PRONOSTICO=30
NOTICIAS_LIMITE=50
# Conservador, Moderado o Agresivo (se cambia arriba en la app)
PERFIL_POR_DEFECTO=Moderado
# Proyeccion de la cartera completa: ETF de acciones de referencia, retorno
# esperado anual SUPUESTO para las acciones y volatilidad de respaldo
TICKER_RENTA_VARIABLE=VTI
RETORNO_ESPERADO_ACCIONES=0.07
VOLATILIDAD_ACCIONES_RESPALDO=0.16

# --- Aplicacion -------------------------------------------
APP_PUERTO=8501
CACHE_HORAS_VIGENCIA=24
SEMANAS_EN_MEMORIA=8

# --- Bonos individuales (formulario N-PORT de la SEC) -----
# La SEC exige identificarse con nombre y correo en cada consulta automatizada
SEC_USER_AGENT=FundScope Tu Nombre tu_correo@ejemplo.com
# Dias que se reutiliza la cartera descargada (se publica cada trimestre)
NPORT_CACHE_DIAS=7

# --- Historia de noticias ----------------------------------
# Maximo de noticias acumuladas por ticker
NOTICIAS_MAXIMO_ACUMULADO=5000

# --- Fuentes de noticias (gratuitas) ----------------------
# Titulares: "gratuitas" combina Yahoo Finance, su feed RSS y Google News (sin clave).
# "alphavantage" agrega primero Alpha Vantage (usa ALPHA_VANTAGE_API_KEY; su plan
# gratuito no permite pedir fechas pasadas).
NOTICIAS_FUENTE=gratuitas
# Tono diario de la prensa (GDELT, gratis y sin clave). Vacio = se deduce del fondo
# (VFIAX/VOO -> "S&P 500"). Ejemplos: "S&P 500", "bond market", "Nasdaq"
TEMA_TONO_PRENSA=
# GDELT pide no hacer mas de una consulta cada 5 segundos
GDELT_PAUSA_SEGUNDOS=5.5
